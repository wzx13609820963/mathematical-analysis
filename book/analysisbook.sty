\NeedsTeXFormat{LaTeX2e}
\ProvidesPackage{analysisbook}[2026/08/11 Mathematics analysis textbook style]

\newif\ifanalysisprint
\DeclareOption{screen}{\analysisprintfalse}
\DeclareOption{print}{\analysisprinttrue}
\ExecuteOptions{screen}
\ProcessOptions\relax

\RequirePackage{amsmath,amssymb,amsthm,mathtools}
\RequirePackage{geometry}
\RequirePackage{xcolor}
\RequirePackage{enumitem}
\RequirePackage{booktabs}
\RequirePackage{fancyhdr}
\RequirePackage{hyperref}
\RequirePackage[most]{tcolorbox}

% ctex's LuaLaTeX Fandol preset does not declare a bold-italic CJK face.
% Complete the existing main-family declaration with that shape so that
% emphasized description labels do not trigger a font substitution warning.
\ifLuaTeX
  \DeclareFontShape{LTJY3}{FandolSong-Regular(0)}{bx}{it}
    {<-> ssub * FandolSong-Regular(0)/m/it}{}
\fi

\geometry{a4paper,inner=30mm,outer=25mm,top=28mm,bottom=30mm,headheight=15pt}
\setlength{\parindent}{2em}
\setlength{\parskip}{0.25em}
\linespread{1.22}
\allowdisplaybreaks[3]

% Screen palette: restrained blue-green headings and low-saturation panels.
% Ordinary cross-references remain black; color is reserved for hierarchy and
% a small number of semantic boxes.  Print mode reduces everything to gray.
\definecolor{AnalysisBlue}{HTML}{315D66}
\definecolor{AnalysisLightBlue}{HTML}{EEF4F4}
\definecolor{AnalysisGold}{HTML}{876A37}
\definecolor{AnalysisLightGold}{HTML}{FAF6EA}
\definecolor{AnalysisRed}{HTML}{874646}
\definecolor{AnalysisLightRed}{HTML}{FAF0F0}
\definecolor{AnalysisGray}{HTML}{5D666B}
\definecolor{AnalysisLightGray}{HTML}{F3F5F5}
% Compatibility names used by the existing exercise and note commands.
\colorlet{AnalysisPurple}{AnalysisBlue}
\colorlet{AnalysisLightPurple}{AnalysisLightBlue}

\hypersetup{
  bookmarksnumbered=true,
  bookmarksdepth=1,
  pdfauthor={数学分析教材编写项目},
  pdftitle={从高等数学到数学分析：严格基础、经典理论与现代分析}
}

\ifanalysisprint
  \colorlet{AnalysisPurple}{black}
  \colorlet{AnalysisLightPurple}{AnalysisLightGray}
  \colorlet{AnalysisBlue}{black}
  \colorlet{AnalysisLightBlue}{AnalysisLightGray}
  \colorlet{AnalysisGold}{AnalysisGray}
  \colorlet{AnalysisLightGold}{white}
  \colorlet{AnalysisRed}{black}
  \colorlet{AnalysisLightRed}{AnalysisLightGray}
  \colorlet{AnalysisHeading}{black}
  \hypersetup{hidelinks}
\else
  \colorlet{AnalysisHeading}{AnalysisBlue}
  \hypersetup{
    colorlinks=true,
    linkcolor=black,
    filecolor=black,
    citecolor=AnalysisGold,
    urlcolor=AnalysisBlue
  }
\fi

% Keep the front-matter contents and PDF bookmarks at section level.  Body
% subsections remain numbered, but no longer make the contents unwieldy.
\setcounter{tocdepth}{1}
\setcounter{secnumdepth}{2}

\ctexset{
  part={
    name={第,编},
    number=\chinese{part},
    format=\centering\Huge\bfseries\color{AnalysisHeading}
  },
  chapter={
    name={第,章},
    number=\arabic{chapter},
    format=\huge\bfseries\color{AnalysisHeading},
    beforeskip=12pt,
    afterskip=28pt
  },
  section={
    format=\Large\bfseries\color{AnalysisHeading}
  },
  subsection={
    format=\large\bfseries
  }
}

\pagestyle{fancy}
\fancyhf{}
\fancyhead[LE]{\small\color{AnalysisGray}\thepage\quad 数学分析}
\fancyhead[RO]{\small\color{AnalysisGray}\leftmark\quad\thepage}
\renewcommand{\headrulewidth}{0.4pt}
\fancypagestyle{plain}{
  \fancyhf{}
  \fancyfoot[C]{\thepage}
  \renewcommand{\headrulewidth}{0pt}
}

\setlist[itemize]{leftmargin=2.2em,itemsep=0.25em,topsep=0.4em}
\setlist[enumerate]{leftmargin=2.5em,itemsep=0.35em,topsep=0.4em}

\newtheoremstyle{analysisplain}
  {0.8em}{0.8em}{\itshape}{}% space above/below, body, indent
  {\bfseries\color{AnalysisHeading}}{.}{0.5em}{}
\newtheoremstyle{analysisdefinition}
  {0.8em}{0.8em}{\normalfont}{}% space above/below, body, indent
  {\bfseries\color{AnalysisHeading}}{.}{0.5em}{}
\theoremstyle{analysisplain}
\newtheorem{theorem}{定理}[chapter]
\newtheorem{lemma}[theorem]{引理}
\newtheorem{proposition}[theorem]{命题}
\newtheorem{corollary}[theorem]{推论}
\theoremstyle{analysisdefinition}
\newtheorem{definition}[theorem]{定义}
\newtheorem{example}[theorem]{例}
\newtheorem{counterexample}[theorem]{反例}
\newtheorem{remark}[theorem]{注}

\renewcommand{\proofname}{证明}

\newtcolorbox{chapterguide}{
  breakable,
  colback=AnalysisLightBlue,
  colframe=AnalysisBlue,
  boxrule=0.7pt,
  arc=1mm,
  title=本章导引,
  fonttitle=\bfseries
}

\newtcolorbox{motivationbox}[1][概念动机]{
  breakable,
  colback=AnalysisLightGold,
  colframe=AnalysisGold,
  boxrule=0.7pt,
  arc=1mm,
  title=#1,
  fonttitle=\bfseries
}

\newtcolorbox{warningbox}[1][常见误解]{
  breakable,
  colback=AnalysisLightRed,
  colframe=AnalysisRed,
  boxrule=0.7pt,
  arc=1mm,
  title=#1,
  fonttitle=\bfseries
}

\newtcolorbox{connectionbox}[1][与后文的联系]{
  breakable,
  colback=AnalysisLightGray,
  colframe=AnalysisGray,
  boxrule=0.7pt,
  arc=1mm,
  title=#1,
  fonttitle=\bfseries
}

\newtcolorbox{insightbox}[1][提示]{
  breakable,
  colback=AnalysisLightPurple,
  colframe=AnalysisPurple,
  boxrule=0.65pt,
  arc=1.5mm,
  title=#1,
  fonttitle=\bfseries
}

\newtcolorbox{notationbox}[1][记号]{
  breakable,
  colback=AnalysisLightGold,
  colframe=AnalysisGold,
  boxrule=0.65pt,
  arc=1.5mm,
  title=#1,
  fonttitle=\bfseries
}

\newtcolorbox{summarybox}{
  breakable,
  colback=AnalysisLightBlue,
  colframe=AnalysisBlue,
  boxrule=0.9pt,
  arc=1mm,
  title=本章小结,
  fonttitle=\bfseries
}

\newcommand{\term}[1]{\textbf{#1}}
\newcommand{\set}[1]{\left\{#1\right\}}
\newcommand{\abs}[1]{\left|#1\right|}
\newcommand{\norm}[1]{\left\lVert#1\right\rVert}
\newcommand{\N}{\mathbb{N}}
\newcommand{\Npos}{\mathbb{N}_{>0}}
\newcommand{\Z}{\mathbb{Z}}
\newcommand{\Q}{\mathbb{Q}}
\newcommand{\R}{\mathbb{R}}
\newcommand{\C}{\mathbb{C}}

% Stable cross-reference helpers.  The visible number is always supplied by
% LaTeX; the argument is a semantic label key, not a printed chapter number.
\newcommand{\chapterref}[1]{第~\ref{#1}~章}
\newcommand{\sectionref}[1]{第~\ref{#1}~节}
\newcommand{\theoremref}[1]{定理~\ref{#1}}
\newcommand{\equationref}[1]{式~\eqref{#1}}
\newcommand{\exerciseitem}[1]{\item\label{ex:#1}}
\newcommand{\optionalexerciseitem}[1]{%
  \item\label{ex:#1}\textcolor{AnalysisPurple}{\textsuperscript{\ensuremath{\star}}}\nobreakspace}
\newcommand{\projectexerciseitem}[1]{%
  \item\label{ex:#1}\textcolor{AnalysisPurple}{\textsuperscript{\ensuremath{\star}}}\nobreakspace%
  \textcolor{AnalysisGold}{\bfseries [项目]}\nobreakspace}
\newcommand{\openexerciseitem}[1]{%
  \item\label{ex:#1}\textcolor{AnalysisPurple}{\textsuperscript{\ensuremath{\star}}}\nobreakspace%
  \textcolor{AnalysisGray}{\bfseries [开放]}\nobreakspace}
\newcommand{\exerciseref}[1]{习题~\ref{ex:#1}\allowbreak}
\newcommand{\exerciserange}[2]{习题~\ref{ex:#1}--\ref{ex:#2}\allowbreak}

\newenvironment{solution}[1]
  {\par\medskip\phantomsection\label{sol:#1}\noindent{\bfseries\color{black}\exerciseref{#1}}\quad}
  {\par\medskip}

% Compatibility shims for unmigrated sources; new exercises use the four item
% commands above so that the optional star can sit next to the printed number.
\newcommand{\mustdo}{}
\newcommand{\optionaldo}{\textcolor{AnalysisPurple}{\ensuremath{\star}}\nobreakspace}
\newcommand{\projectdo}{\textcolor{AnalysisGold}{\bfseries [项目]}\nobreakspace}
\newcommand{\opendo}{\textcolor{AnalysisGray}{\bfseries [开放]}\nobreakspace}

\makeatletter
\providecommand*{\toclevel@volume}{-2}
\newcommand*\l@volume{\@dottedtocline{-1}{0em}{0em}}
\newcommand{\volume}[1]{%
  \cleardoublepage
  \phantomsection
  \addcontentsline{toc}{volume}{#1}
  \thispagestyle{empty}
  \vspace*{0.2\textheight}
  \begin{center}
    {\Huge\bfseries\color{AnalysisHeading}#1\par}
  \end{center}
  \vfill
  \cleardoublepage
}
\makeatother
